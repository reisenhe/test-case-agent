[
  {
    "id": "TC-FP-LOGIN-005-001",
    "feature_point_id": "FP-LOGIN-005",
    "title": "注册新用户后验证数据库中密码为哈希值而非明文",
    "purpose": "验证用户注册时输入的明文密码在持久化到数据库前已被单向哈希加密，且不包含可逆加密或明文存储",
    "priority": "P1",
    "type": "安全",
    "preconditions": [
      "1. 系统已配置 bcrypt 加密机制（工作因子=12）",
      "2. 数据库可直接查询（测试环境启用调试模式）",
      "3. 用户未注册，用户名 'secuser123' 可用"
    ],
    "steps": [
      {
        "step_no": 1,
        "action": "通过注册接口提交新用户信息",
        "test_data": "{\"username\":\"secuser123\",\"password\":\"SecurePass!2024\"}",
        "expected_result": "返回 HTTP 201，响应体包含 {\"success\":true,\"userId\":123}"
      },
      {
        "step_no": 2,
        "action": "查询数据库 users 表中 username='secuser123' 的 password 字段",
        "test_data": "",
        "expected_result": "password 字段值为长度≥60的bcrypt哈希字符串（如 '$2b$12$...xxxxxxxxxxxxxxxxxxxxxxx'），不等于 'SecurePass!2024'"
      }
    ],
    "postconditions": [
      "用户记录存在于数据库中",
      "password 字段不可逆解密"
    ],
    "tags": [
      "密码安全",
      "加密存储",
      "P1",
      "安全"
    ]
  },
  {
    "id": "TC-FP-LOGIN-005-002",
    "feature_point_id": "FP-LOGIN-005",
    "title": "验证密码字段无明文残留或日志泄露",
    "purpose": "验证系统在任何环节（注册、登录、更新密码）均不在应用日志、审计日志或错误堆栈中记录明文密码",
    "priority": "P1",
    "type": "安全",
    "preconditions": [
      "1. 系统日志级别设为 DEBUG",
      "2. 日志输出路径可访问（/var/log/app/security.log）",
      "3. 用户 'logcheckuser' 已存在，密码为 'LogTest@2024'"
    ],
    "steps": [
      {
        "step_no": 1,
        "action": "执行密码更新操作（调用 /api/v1/users/password）",
        "test_data": "{\"oldPassword\":\"LogTest@2024\",\"newPassword\":\"NewSecure!2024\"}",
        "expected_result": "返回 HTTP 200，响应体为 {\"success\":true}"
      },
      {
        "step_no": 2,
        "action": "检索最近5分钟所有日志文件中是否包含明文密码字符串",
        "test_data": "搜索关键词 'LogTest@2024' 和 'NewSecure!2024'",
        "expected_result": "日志文件中未匹配到任一明文密码；仅存在脱敏占位符（如 'password: [REDACTED]'）或哈希摘要（如 'password_hash_length: 60'）"
      }
    ],
    "postconditions": [
      "密码更新成功",
      "日志中无敏感信息明文痕迹"
    ],
    "tags": [
      "密码安全",
      "日志安全",
      "P1",
      "安全"
    ]
  },
  {
    "id": "TC-FP-LOGIN-003-001",
    "feature_point_id": "FP-LOGIN-003",
    "title": "用户名错误时显示错误提示",
    "purpose": "验证当输入不存在的用户名时，系统显示准确的错误提示信息",
    "priority": "P3",
    "type": "逆向",
    "preconditions": [
      "1. 用户已注册，正确用户名: testuser，密码: Pass123456",
      "2. 系统正常运行",
      "3. 登录页面已打开"
    ],
    "steps": [
      {
        "step_no": 1,
        "action": "输入不存在的用户名",
        "test_data": "nonexistent_user",
        "expected_result": "用户名输入框显示 \"nonexistent_user\""
      },
      {
        "step_no": 2,
        "action": "输入正确密码",
        "test_data": "Pass123456",
        "expected_result": "密码输入框显示掩码 \"********\""
      },
      {
        "step_no": 3,
        "action": "点击登录按钮",
        "test_data": "",
        "expected_result": "1. 页面不跳转\n2. 显示统一错误提示 \"用户名或密码错误\"\n3. 错误提示区域高亮显示"
      }
    ],
    "postconditions": [
      "用户仍处于未登录状态",
      "登录失败计数+1"
    ],
    "tags": [
      "登录",
      "异常处理",
      "用户名错误",
      "P3"
    ]
  },
